# Build-time env for the Astro site itself (read via import.meta.env), separate from
# .dev.vars.example which covers functions/api/contact.ts's runtime secrets.
#
# Copy to .env locally only if you need to test the Turnstile widget rendering — leave unset
# and the site builds exactly as before, with zero third-party requests (see ContactForm.astro
# and the ALLOWED_EXTERNAL_HOSTS note in scripts/verify-output.mjs).

PUBLIC_TURNSTILE_SITE_KEY=
