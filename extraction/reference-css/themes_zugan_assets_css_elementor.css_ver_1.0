	}
}
.portfolio-single-1 .project-details h3 {
	font-size: 21px;
    color: #111111;
    position: relative;
    padding-bottom: 16px;
	margin-bottom: 30px;
}
.portfolio-single-1 .project-details h3:after {
    content: "";
    height: 4px;
    width: 40px;
    background-color: #111111;
    bottom: 0;
    left: 0;
    position: absolute;
}
ul.rtin-portfolio-info li {
    display: flex;
