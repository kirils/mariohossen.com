		margin-right: 15px;
	}
}
ul.rtin-portfolio-info .rtin-social li:last-child {
	margin-right: 0;
}
ul.rtin-portfolio-info .rtin-social li a {
    margin-right: 0;
    color: #646464;
}
ul.rtin-portfolio-info .rtin-social li a:hover {
    color: #111111;
}
.portfolio-single-1 .zugan-button-2 {
	margin-top: 25px;
