.woocommerce table.shop_attributes td {
  padding: 0 8px;
}
.woocommerce #reviews #comments {
  margin-bottom: 20px;
}
.woocommerce #reviews #comments h2 {
  margin-bottom: 30px;
}
.woocommerce #reviews #comments ol.commentlist {
