{
  "name": "mariohossen-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Static rebuild of mariohossen.com — Mario Hossen, violin soloist and conductor",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "npm run format:check && npm run lint && npm run test:content && npm run check && npm run build && npm run check:output",
    "check:output": "node scripts/verify-output.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:content": "node --test 'extraction/tools/lib/*.test.mjs'",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
