---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Mario Hossen – violin soloist and conductor">
  <div class="mx-auto max-w-(--container-site) px-5 py-20 md:px-10">
    <h1 class="font-display text-gold text-[32px] font-light tracking-[0.15em] md:text-[42px]">
      MARIO HOSSEN
    </h1>

    <p class="mt-6 max-w-2xl">
      Scaffold in place. The page sections are built in Phase 5 — see
      <code class="text-gold">docs/plan/05-task-list.md</code>.
    </p>

    <p class="mt-4 text-sm">
      Design tokens, self-hosted fonts and the build pipeline are wired up and verified.
    </p>
  </div>
</BaseLayout>
