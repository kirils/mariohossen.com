---
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'

interface Props {
  title: string
  description?: string
  /** Path-only canonical, e.g. "/contact/". Defaults to the current URL. */
  canonical?: string
}

const { title, description, canonical } = Astro.props

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site)
const desc =
  description ??
  'Mario Hossen — Austro-Bulgarian violin soloist and conductor. Concerts, recordings, editions and biography.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mario Hossen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      /* Blocking on purpose: this must land before first paint. It gates the scroll-reveal
       hidden state (.js [data-reveal] in global.css) so content is only ever hidden when a
       script is confirmed to be running to un-hide it later — never on a no-JS visit. */
    }
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="focus:bg-gold focus:text-ink sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2"
    >
      Skip to content
    </a>

    <Header />

    {
      /* Icon shapes used by HoverIcon.astro (Gallery/Recordings hover badges), defined once and
       referenced everywhere via <use> — up to 33 grid items would otherwise each repeat the
       full path data inline, which is what pushed index.html over its HTML budget. */
    }
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <symbol
        id="i-link"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </symbol>
      <symbol
        id="i-zoom"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="10" cy="10" r="7"></circle>
        <line x1="21" y1="21" x2="15" y2="15"></line>
        <line x1="10" y1="7" x2="10" y2="13"></line>
        <line x1="7" y1="10" x2="13" y2="10"></line>
      </symbol>
    </svg>

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
