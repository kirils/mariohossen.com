---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  /** Path-only canonical, e.g. "/contact/". Defaults to the current URL. */
  canonical?: string
}

const { title, description, canonical } = Astro.props

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site)
const desc =
  description ??
  'Mario Hossen — Austro-Bulgarian violin soloist and conductor. Concerts, recordings, editions and biography.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mario Hossen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a
      href="#main"
      class="focus:bg-gold focus:text-ink sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2"
    >
      Skip to content
    </a>

    <main id="main">
      <slot />
    </main>
  </body>
</html>
