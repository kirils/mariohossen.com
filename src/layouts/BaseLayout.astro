---
import { getImage } from 'astro:assets'
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import { withBase } from '../lib/url'
import { personSchema } from '../lib/schema'
import shareImageSource from '../assets/images/gallery/Mario-Hossen-1.jpg'
import faviconSource from '../assets/brand/favicon-source.png'

interface Props {
  title: string
  description?: string
  /** Path-only canonical, e.g. "/contact/". Defaults to the current URL. */
  canonical?: string
  /** 404 and similar non-content pages shouldn't be indexed. */
  noindex?: boolean
  /**
   * Extra JSON-LD nodes beyond the site-wide Person (task 7.3) — e.g. index.astro's upcoming
   * Events and MusicAlbums. Merged into one `@graph` rather than one <script> per entity type.
   */
  structuredData?: Record<string, unknown>[]
}

const { title, description, canonical, noindex = false, structuredData = [] } = Astro.props
const jsonLd = { '@context': 'https://schema.org', '@graph': [personSchema(), ...structuredData] }

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site)
const desc =
  description ??
  'Mario Hossen — Austro-Bulgarian violin soloist and conductor. Concerts, recordings, editions and biography.'

// One fixed share image for every page — task 7.2. 1200×630 is the OpenGraph-recommended size;
// `fit: 'cover'` crops the source (a landscape studio portrait, gallery item 01) to match it.
// JPG, not AVIF/WebP: social-media crawlers (Facebook, older link-preview bots) are far less
// reliable at rendering modern formats for share images than browsers are for page content.
const shareImage = await getImage({
  src: shareImageSource,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
})
// getImage's output path already respects astro.config.mjs's `base` (see src/lib/url.ts) —
// wrapping it in withBase() again would double-prefix it on the GitHub Pages build.
const shareImageUrl = new URL(shareImage.src, Astro.site)

// The site's real favicon — the original's own favicon_MH_violine.png (a photo of the scroll of
// Mario Hossen's violin, archived at assets/originals/2020/07/), not the generic SVG mark placed
// here as a stand-in before this was tracked down. PNG, not SVG: the source is a photograph, not
// vector art. Sized to match what each `rel` actually needs, rather than the original's own
// markup, which declared sizes="192x192" on a file that was really 300×300.
const favicon32 = await getImage({ src: faviconSource, width: 32, height: 32, format: 'png' })
const favicon192 = await getImage({ src: faviconSource, width: 192, height: 192, format: 'png' })
const appleTouchIcon = await getImage({
  src: faviconSource,
  width: 180,
  height: 180,
  format: 'png',
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" href={favicon32.src} sizes="32x32" type="image/png" />
    <link rel="icon" href={favicon192.src} sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mario Hossen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={shareImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mario Hossen playing the violin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={shareImageUrl.href} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      /* Blocking on purpose: this must land before first paint. It gates the scroll-reveal
       hidden state (.js [data-reveal] in global.css) so content is only ever hidden when a
       script is confirmed to be running to un-hide it later — never on a no-JS visit. */
    }
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="focus:bg-gold focus:text-ink sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2"
    >
      Skip to content
    </a>

    <Header />

    {
      /* Icon shapes used by HoverIcon.astro (Gallery/Recordings hover badges), defined once and
       referenced everywhere via <use> — up to 33 grid items would otherwise each repeat the
       full path data inline, which is what pushed index.html over its HTML budget. */
    }
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
      <symbol
        id="i-link"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </symbol>
      <symbol
        id="i-zoom"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="10" cy="10" r="7"></circle>
        <line x1="21" y1="21" x2="15" y2="15"></line>
        <line x1="10" y1="7" x2="10" y2="13"></line>
        <line x1="7" y1="10" x2="13" y2="10"></line>
      </symbol>
    </svg>

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
