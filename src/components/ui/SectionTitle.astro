---
import GoldRule from './GoldRule.astro'

interface Props {
  /** Visible text, e.g. "REPERTOIRE". Rendered upper-case via CSS, so pass normal case. */
  text: string
  /** Anchor id for nav links (`/#repertoire`). */
  id?: string
  class?: string
}

const { text, id, class: className = '' } = Astro.props
---

<div class={`mb-10 ${className}`} id={id}>
  <h2 class="font-display text-gold text-[32px] font-light tracking-wide uppercase">
    {text}
  </h2>
  <GoldRule class="mt-4" />
</div>
