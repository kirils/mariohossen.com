---
/**
 * The "purple → gold" transition around the Concerts section.
 *
 * This is not a bespoke illustration — it is Elementor's stock "mountains" shape divider.
 * The path data and fill colours below are copied verbatim from the live site's rendered HTML
 * and CSS (search `elementor-shape-fill` in extraction/rendered/home.rendered.html), not traced
 * from a screenshot. The bottom variant reuses the identical three paths, rotated 180deg, per
 * the site's own CSS rule for `.elementor-shape-bottom`.
 *
 * See docs/plan/03-design-system.md "The curved divider" for the measurement trail.
 */
interface Props {
  variant: 'top' | 'bottom'
}

const { variant } = Astro.props

// Fill colours measured from post-2320.css. Both sit on the gold `#B09153` section background.
const FILL = variant === 'top' ? '#230B66' : '#1D0956'
const HEIGHT = variant === 'top' ? 35 : 50
---

<div
  class="pointer-events-none absolute inset-x-0 overflow-hidden leading-none"
  class:list={[variant === 'top' ? '-top-px' : '-bottom-px']}
  style={variant === 'bottom' ? { transform: 'rotate(180deg)' } : undefined}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 1000 100"
    preserveAspectRatio="none"
    class="block w-[calc(100%+2px)]"
    style={{ height: `${HEIGHT}px` }}
  >
    <path
      fill={FILL}
      opacity="0.33"
      d="M473,67.3c-203.9,88.3-263.1-34-320.3,0C66,119.1,0,59.7,0,59.7V0h1000v59.7 c0,0-62.1,26.1-94.9,29.3c-32.8,3.3-62.8-12.3-75.8-22.1C806,49.6,745.3,8.7,694.9,4.7S492.4,59,473,67.3z"
    ></path>
    <path
      fill={FILL}
      opacity="0.66"
      d="M734,67.3c-45.5,0-77.2-23.2-129.1-39.1c-28.6-8.7-150.3-10.1-254,39.1 s-91.7-34.4-149.2,0C115.7,118.3,0,39.8,0,39.8V0h1000v36.5c0,0-28.2-18.5-92.1-18.5C810.2,18.1,775.7,67.3,734,67.3z"
    ></path>
    <path
      fill={FILL}
      d="M766.1,28.9c-200-57.5-266,65.5-395.1,19.5C242,1.8,242,5.4,184.8,20.6C128,35.8,132.3,44.9,89.9,52.5C28.6,63.7,0,0,0,0 h1000c0,0-9.9,40.9-83.6,48.1S829.6,47,766.1,28.9z"
    ></path>
  </svg>
</div>
