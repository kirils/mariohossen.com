---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import SectionTitle from '../ui/SectionTitle.astro'
import Accordion from '../ui/Accordion.astro'
// The Repertoire section's own portrait (tuxedo, white bow tie) — a second portrait distinct
// from the biography one, hardcoded like the header logo since it is a fixed decorative slot
// in this specific layout, not per-item content. See extraction/tools/sort-images.mjs.
import repertoirePortrait from '../../assets/images/portraits/MHossen.jpg'

const categories = (await getCollection('repertoire')).sort((a, b) => a.data.order - b.data.order)
const rendered = await Promise.all(categories.map((c) => render(c)))
---

<section id="repertoire" class="bg-bg py-16 md:py-20" data-reveal>
  <div class="mx-auto max-w-(--container-site) px-5 md:px-10">
    <SectionTitle text="Repertoire" />

    {
      /* Measured directly against the live site (elementor-column bounding rects at a 1240px
       container): accordion column 744px, portrait column 496px — an exact 3:2 (60/40) split,
       not the 5:2 (71/29) this previously assumed, which rendered the portrait noticeably
       smaller than the original. */
    }
    <div class="grid gap-8 md:grid-cols-[3fr_2fr] md:gap-10">
      <div class="divide-y divide-black/10">
        {
          categories.map((cat, i) => {
            const { Content } = rendered[i]
            return (
              <Accordion variant="gold" title={cat.data.title}>
                <div class="prose-repertoire text-text">
                  <Content />
                </div>
              </Accordion>
            )
          })
        }
      </div>

      <div class="hidden md:block">
        <Image
          src={repertoirePortrait}
          alt="Mario Hossen in formal white tie, holding his violin"
          class="w-full"
          widths={[400, 700, 900]}
          sizes="50vw"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* The repertoire body is plain rendered markdown (### composer headings, - work lists, or
     flat paragraphs for the one category with neither) — a few scoped rules stand in for a
     full prose plugin, which would be overkill for three element types. */
  .prose-repertoire :global(h3) {
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
    color: var(--color-gold);
  }
  .prose-repertoire :global(h3:first-child) {
    margin-top: 0;
  }
  .prose-repertoire :global(ul) {
    margin-bottom: 1rem;
    list-style: none;
    padding: 0;
  }
  .prose-repertoire :global(li) {
    margin-bottom: 0.35rem;
  }
  .prose-repertoire :global(p) {
    margin-bottom: 0.75rem;
  }
</style>
