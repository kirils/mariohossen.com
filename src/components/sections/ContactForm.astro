---
/**
 * Phase 6: functions/api/contact.ts now receives this POST — Zod validation, honeypot,
 * minimum-submit-time, optional Turnstile verification, then Resend. The <script> below is a
 * progressive enhancement only: it intercepts submit to show the aria-live states from task 6.7
 * without a page navigation, but the plain `method="post"` form works identically with it
 * disabled (task 6.6) — the Function itself branches on the request's Accept header rather than
 * assuming JS ran.
 *
 * The form action is deliberately left as a literal "/api/contact", not base-prefixed — it's
 * a Cloudflare Pages Function route at the true domain root on the real deploy target, and it
 * doesn't exist yet regardless (GitHub Pages can't run it either way).
 *
 * Turnstile only loads once the client has configured PUBLIC_TURNSTILE_SITE_KEY in Cloudflare
 * Pages — until then, the build stays free of the one intentional third-party request this site
 * makes (see the allowlist note in scripts/verify-output.mjs), matching CLAUDE.md's "no
 * third-party runtime requests" rule by only turning it on when the client deliberately does.
 */
import { withBase } from '../../lib/url'

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined
---

<div>
  <h2 class="font-display text-gold text-[26px] font-light uppercase">Contact</h2>

  <form action="/api/contact" method="post" class="mt-6 space-y-4" data-contact-form>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="contact-name" class="sr-only">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          placeholder="Name*"
          class="text-ink w-full bg-white px-4 py-3 placeholder:text-black/50"
        />
      </div>
      <div>
        <label for="contact-email" class="sr-only">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          placeholder="Email*"
          class="text-ink w-full bg-white px-4 py-3 placeholder:text-black/50"
        />
      </div>
    </div>

    <div>
      <label for="contact-subject" class="sr-only">Subject</label>
      <input
        id="contact-subject"
        name="subject"
        type="text"
        required
        placeholder="Subject*"
        class="text-ink w-full bg-white px-4 py-3 placeholder:text-black/50"
      />
    </div>

    <div>
      <label for="contact-message" class="sr-only">Message</label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        required
        placeholder="Message*"
        class="text-ink w-full bg-white px-4 py-3 placeholder:text-black/50"></textarea>
    </div>

    {/* Honeypot for Phase 6's spam filtering — real visitors never see or fill this in. */}
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      class="hidden"
      aria-hidden="true"
    />

    {
      /* Stamped by the script below with the render time, so the Function can reject a submit
       that arrives implausibly fast. Left empty (and the check skipped server-side) when JS
       never runs — see functions/api/contact.ts. */
    }
    <input type="hidden" name="formLoadedAt" data-form-loaded-at />

    {
      turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />
      )
    }

    <label class="text-text flex items-start gap-2 text-sm">
      <input type="checkbox" name="consent" required class="mt-1" />
      <span>
        I agree to the terms set out in the <a
          href={withBase('/privacy/')}
          class="hover:text-gold underline">privacy policy</a
        > *
      </span>
    </label>

    <p
      class="hidden text-sm font-bold text-white"
      role="status"
      aria-live="polite"
      data-contact-status
    >
    </p>

    <button
      type="submit"
      class="border-gold hover:bg-gold hover:text-ink w-full border bg-black py-3.5 text-sm text-white transition-colors disabled:opacity-60"
    >
      send message
    </button>
  </form>
</div>

{
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<script>
  export {}
  declare global {
    interface Window {
      turnstile?: { reset: () => void }
    }
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')

  if (form) {
    const loadedAt = form.querySelector<HTMLInputElement>('[data-form-loaded-at]')
    if (loadedAt) loadedAt.value = String(Date.now())

    const status = form.querySelector<HTMLElement>('[data-contact-status]')
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')

    const showStatus = (message: string) => {
      if (!status) return
      status.textContent = message
      status.classList.remove('hidden')
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      submitBtn?.setAttribute('disabled', '')
      status?.classList.add('hidden')

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        })
        const result = (await response.json().catch(() => ({ ok: response.ok }))) as {
          ok: boolean
          error?: string
        }

        if (result.ok) {
          form.reset()
          window.turnstile?.reset()
          showStatus('Thanks for reaching out — I will get back to you soon.')
        } else {
          showStatus(result.error ?? 'Something went wrong — please try again.')
        }
      } catch {
        showStatus('Could not reach the server — please try again or email directly.')
      } finally {
        submitBtn?.removeAttribute('disabled')
      }
    })
  }
</script>
