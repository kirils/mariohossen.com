---
/**
 * The four social links, hand-drawn as inline SVG rather than pulling in an icon font
 * (the original loads all of Font Awesome for four glyphs). Measured on the live site:
 * 27x27px hit area, 15px glyph, white, gold on hover.
 */
interface Props {
  class?: string
  iconClass?: string
  /** Colour classes for the <a>, including hover. Defaults to the header's white/gold pairing. */
  linkClass?: string
}

