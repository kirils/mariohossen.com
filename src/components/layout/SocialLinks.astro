---

<ul class={`flex items-center gap-4 ${className}`}>
  {
    LINKS.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.name}
          class={`flex h-[27px] w-[27px] items-center justify-center transition-colors ${linkClass}`}
        >
          <svg viewBox="0 0 24 24" class={iconClass} fill="currentColor" aria-hidden="true">
            <path d={link.path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
