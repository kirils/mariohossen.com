---
/**
 * The gold footer bar. Measured: bg #B09153, all text/links #000000 (never gold-on-gold —
 * see the contrast note in docs/plan/03-design-system.md).
 */
import SocialLinks from './SocialLinks.astro'

const YEAR = new Date().getFullYear()

const LINKS = [
  { label: 'Contact', href: '/contact/' },
  { label: 'Imprint', href: '/imprint/' },
  { label: 'Cookie Policy (EU)', href: '/privacy/' },
] as const
---

<footer class="bg-gold text-ink py-6">
  <div
    class="mx-auto flex max-w-(--container-site) flex-col items-center gap-4 px-5 text-center md:flex-row md:justify-between md:px-10 md:text-left"
  >
    <p class="text-xs">&copy; Copyright &ndash; Mario Hossen {YEAR}</p>

    <nav aria-label="Footer">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {
          LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-xs underline-offset-2 hover:underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <SocialLinks iconClass="h-4 w-4" linkClass="text-ink hover:text-white" />
  </div>
</footer>
