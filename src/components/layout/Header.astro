---
import logoSource from '../../assets/brand/logo-mario-hossen.svg?raw'
import SocialLinks from './SocialLinks.astro'
import MobileMenu from './MobileMenu.astro'
import GoldRule from '../ui/GoldRule.astro'
import { withBase } from '../../lib/url'

// The source file bakes its gold fill into an embedded <style>/.st1 class. Stripped so the
// colour instead comes from the design token (.logo-mark svg path in global.css) — one
// source of truth for "gold" — and so the class="st1" text (harmless but pointless) doesn't
// leak into el.textContent for anything that queries the <h1>.
const logoRaw = logoSource.replace(/<style[^>]*>.*?<\/style>/s, '')

/**
 * Centred, stacked layout: social row → wordmark → nav → gold hairline. Measured header
 * height on the original is 157px; this reproduces the same rhythm rather than a fixed height,
 * since content-driven height is more robust to font-rendering differences across browsers.
 */
const NAV = [
  { label: 'biography', href: withBase('/#biography') },
  { label: 'repertoire', href: withBase('/#repertoire') },
  { label: 'concerts', href: withBase('/#concerts') },
  { label: 'recordings', href: withBase('/#recordings') },
  { label: 'editions', href: withBase('/#editions') },
  { label: 'gallery', href: withBase('/#gallery') },
  { label: 'contact', href: withBase('/#contact') },
] as const
---

<header class="bg-bg relative pt-3">
  <div class="mx-auto flex max-w-(--container-site) flex-col items-center px-5 md:px-10">
    <SocialLinks class="mb-1.5" />

    {
      /* The accessible name belongs on the <a> — it's the focusable element, and an aria-label
       on its non-interactive <h1> ancestor doesn't name it (aria-label never cascades to
       descendants). role="img" previously sat on the <h1>, which also meant an "image"
       (semantically childless) contained a real focusable link — axe's link-name and
       nested-interactive checks both point at exactly this. A plain labelled link, with the
       decorative SVG hidden from assistive tech, needs no role override at all. */
    }
    <h1 class="mb-1.5 w-[260px] md:w-[380px]">
      <a href={withBase('/')} class="logo-mark block" aria-label="Mario Hossen">
        <span set:html={logoRaw} aria-hidden="true" />
      </a>
    </h1>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="hover:text-gold text-[13px] font-normal tracking-wide text-white uppercase transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <MobileMenu nav={NAV} class="lg:hidden" />
  </div>

  <div class="mx-auto mt-2 max-w-(--container-site) px-5 md:px-10">
    <GoldRule />
  </div>
</header>
