---
import type { CollectionEntry } from 'astro:content'
import { Picture } from 'astro:assets'

interface Props {
  edition: CollectionEntry<'editions'>
}

const { edition } = Astro.props
const { composer, title, volume, scoring, editor, cover, alt, moreUrl } = edition.data
---

<article class="text-ink flex flex-col bg-white">
  <div class="p-6 pb-0">
    <Picture
      src={cover}
      alt={alt ?? `${composer} — ${title}${volume ? ` ${volume}` : ''}`}
      class="w-full"
      widths={[300, 500, 750]}
      sizes="(max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw"
      loading="lazy"
      formats={['avif', 'webp']}
      pictureAttributes={{ style: 'display: contents' }}
    />
  </div>

  <div class="flex flex-1 flex-col gap-1 px-6 pt-4 text-sm">
    <p class="font-bold">{composer}</p>
    <p>
      {title}
      {volume && <span class="text-text"> {volume}</span>}
    </p>
    {
      scoring && (
        <p class="text-text mt-2 text-xs">
          <span class="font-semibold">Besetzung:</span> {scoring}
        </p>
      )
    }
    {
      editor && (
        <p class="text-text text-xs">
          <span class="font-semibold">Herausgeber:</span> {editor}
        </p>
      )
    }
  </div>

  <div class="p-6 pt-4">
    {
      moreUrl ? (
        <a
          href={moreUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`See more: ${composer} — ${title}${volume ? ` ${volume}` : ''}`}
          class="block bg-black py-2.5 text-center text-[13px] text-white"
        >
          see more
        </a>
      ) : (
        <span class="block bg-black py-2.5 text-center text-[13px] text-white/50">see more</span>
      )
    }
  </div>
</article>
