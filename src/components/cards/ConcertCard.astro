---
import type { CollectionEntry } from 'astro:content'
import { formatConcertDate } from '../../lib/concerts'

interface Props {
  concert: CollectionEntry<'concerts'>
}

const { concert } = Astro.props
const { date, endDate, city, country, venue, series, ensemble, performers, programme, infoUrl } =
  concert.data

const location = country ? `${city} (${country})` : city
---

<article
  class="border p-6 md:p-8"
  style="border-color: rgba(35, 11, 102, 0.24)"
  itemscope
  itemtype="https://schema.org/Event"
>
  <h3
    class="border-l-2 border-white pl-3 text-[26px] leading-tight font-bold text-white md:text-[30px]"
  >
    <time datetime={date.toISOString().slice(0, 10)} itemprop="startDate">
      {formatConcertDate(date, endDate)}
    </time>
  </h3>

  <div class="text-ink mt-4 space-y-0.5 text-[15px] leading-snug font-bold" itemprop="location">
    <p>{location}</p>
    {venue && <p>{venue}</p>}
  </div>

  {
    /* series is the concert's own name (a themed night, festival, or cycle — "Mario Hossen and
     Friends", "China Tour", "Concert Spirituel") — styled as a title distinct from the plain
     detail text below it, at the same 20px/700 scale used for card titles elsewhere on the
     site (recordings, editions), not folded into the ensemble/performers block. */
  }
  {
    series && (
      <p class="mt-4 text-[20px] leading-tight font-bold text-white" itemprop="name">
        {series}
      </p>
    )
  }

  {
    /* A one-line-per-performer list reads well for the usual 2–5 person ensemble, but a large
     guest lineup (e.g. a "…and Friends" festival) would stretch the card far taller than its
     neighbours in the same grid row. Past a handful of names, wrap them into a single
     comma-separated block instead — same type style, far more compact, and every name still
     shown (nothing truncated). */
  }
  {
    (ensemble || performers.length > 0) && (
      <div
        class:list={[
          'space-y-0.5 text-[15px] leading-snug font-bold text-white',
          series ? 'mt-2' : 'mt-4',
        ]}
      >
        {ensemble && <p itemprop="performer">{ensemble}</p>}
        {performers.length > 6 ? (
          <p itemprop="performer">{performers.join(' · ')}</p>
        ) : (
          performers.map((p) => <p itemprop="performer">{p}</p>)
        )}
      </div>
    )
  }

  {
    programme && (
      <p class="text-ink mt-4 text-sm leading-snug font-bold" itemprop="description">
        {programme}
      </p>
    )
  }

  {
    infoUrl && (
      <a
        href={infoUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Info: ${series ?? ensemble ?? location} — ${formatConcertDate(date, endDate)}`}
        class="text-gold mt-6 inline-block bg-black px-5 py-2.5 text-[13px]"
      >
        Info
      </a>
    )
  }
</article>
